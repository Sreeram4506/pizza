# ==============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values.
# These must also be added to Render's dashboard.
# ==============================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/pizzablast?retryWrites=true&w=majority

# Auth
JWT_SECRET=your-super-secret-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# Node Environment
NODE_ENV=production

# Server port (must match the frontend dev proxy target in vite.config.js)
PORT=5000

# Frontend URL (set to your Vercel app URL after deploying)
FRONTEND_URL=https://your-app.vercel.app

# Socket.IO CORS origin (defaults to FRONTEND_URL / VERCEL_URL if unset)
SOCKET_IO_CORS_ORIGIN=

# NVIDIA AI (optional)
NVIDIA_API_KEY=

# Stripe Payments (optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Required to verify Stripe webhook signatures (from the Stripe Dashboard webhook config)
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM="Pizza Blast" <onboarding@resend.dev>

# Admin notification email address (optional, defaults to admin@pizzablast.com)
ADMIN_EMAIL=

# External delivery platform webhook signing secrets (optional)
UBER_EATS_CLIENT_SECRET=
GRUBHUB_CLIENT_SECRET=

# DoorDash Drive API (create an access key in the DoorDash Developer Portal)
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=

# ==============================================
# FRONTEND ENVIRONMENT VARIABLES (VITE)
# These must be added to Vercel's dashboard.
# ==============================================

# Backend URL (your Render service URL)
VITE_API_URL=https://pizzabackend-qzi1.onrender.com

# Backend host for WebSocket (without https://)
VITE_WS_URL=pizzabackend-qzi1.onrender.com

# Stripe (public key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
